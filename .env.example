# Copie ce fichier en .env (local) ou saisis ces variables dans Portainer (Stack > Environment variables).
# Compte propriétaire, créé au premier démarrage (mot de passe à changer ensuite dans l'interface).
ATELIER_BOOTSTRAP_EMAIL=admin@localhost
ATELIER_PASSWORD=change-moi

# Derrière un reverse proxy HTTPS : TRUST_PROXY=1 (IP et schéma lus dans X-Forwarded-*).
# Le cookie de session est alors marqué Secure. Sans proxy, COOKIE_SECURE=1 pour le forcer.
TRUST_PROXY=

# Au moins une clé de fournisseur. Elles restent dans l'orchestrateur, jamais dans les bacs à sable.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Token git (GitLab : scope api + write_repository). Un token par projet possible via "tokenEnv".
GIT_TOKEN=

# Dossier de travail temporaire des tâches. Doit exister sur l'hôte et être partagé avec Docker.
# Serveur Linux : /srv/atelier/work — Mac (test local) : un chemin sous ton dossier utilisateur.
ATELIER_WORKDIR=/srv/atelier/work

# Liste des projets (JSON sur une ligne). Voir projects.example.json.
PROJECTS_JSON=[{"id":"regis","name":"MonRégis","repo":"https://gitlab.example.com/groupe/regis.git","check":"node --check app.js"}]
