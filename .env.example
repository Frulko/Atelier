# Atelier — variables d'environnement.
# Docker : cp .env.example .env && docker compose -f docker-compose.prod.yml up -d
# Portainer : saisis ces variables dans Stacks → ta pile → Environment variables.
# Détail de chaque variable : docs/configuration.md

# ───────── Images (docker-compose.prod.yml) ─────────
# Celles du dépôt par défaut. Épingle une version en production. Pour les tiennes : scripts/release.sh.
ATELIER_IMAGE=ghcr.io/frulko/atelier:latest
ATELIER_SANDBOX_IMAGE=ghcr.io/frulko/atelier-sandbox:latest

# ───────── Obligatoire ─────────
# Mot de passe INITIAL du compte propriétaire, créé au premier démarrage (à changer ensuite dans l'interface).
ATELIER_PASSWORD=change-moi
ATELIER_BOOTSTRAP_EMAIL=admin@localhost

# ───────── Sécurité ─────────
# Derrière un reverse proxy HTTPS (recommandé, obligatoire hors réseau privé) : TRUST_PROXY=1.
# Le cookie de session est alors marqué Secure et l'IP réelle est lue dans X-Forwarded-*.
TRUST_PROXY=
# Clé qui chiffre les secrets en base (openssl rand -base64 32). Si absente, elle est générée dans le volume
# de données : à sauvegarder SÉPARÉMENT de la base ; la perdre rend les secrets illisibles.
ATELIER_MASTER_KEY=
# Liste blanche d'hôtes git pour les projets (ex. gitlab.com,github.com,git.mon-domaine.fr). Vide = tout hôte https.
ATELIER_GIT_HOSTS=
# 1 : la surveillance des sites peut viser le réseau privé (sites internes). Les adresses « métadonnées cloud » restent refusées.
ATELIER_HEALTH_ALLOW_PRIVATE=

# ───────── Exécution ─────────
# Dossier de travail temporaire des tâches. DOIT exister sur l'hôte et avoir le même chemin dans le conteneur
# (le démon Docker de l'hôte le monte dans les bacs à sable). Serveur Linux : /srv/atelier/work.
#   sudo mkdir -p /srv/atelier/work
ATELIER_WORKDIR=/srv/atelier/work
ATELIER_PORT=8080
# Plafond de coût d'une exécution de l'agent, en dollars (réglable par projet dans l'interface).
MAX_BUDGET_USD=2

# ───────── Premier démarrage seulement (facultatif) ─────────
# Lus UNE fois pour peupler l'organisation par défaut ; ensuite tout se gère dans l'interface (Intégrations, Projets).
# Tu peux ne rien mettre ici et tout saisir dans l'interface.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GIT_TOKEN=
# Projets (JSON sur une ligne). Voir projects.example.json.
PROJECTS_JSON=
